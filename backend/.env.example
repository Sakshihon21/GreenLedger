# GreenLedger Backend Environment Configuration

# PostgreSQL Database Connection
# Replace 'postgres' and 'sakshi' with your local PostgreSQL username and password:
# Format: postgresql://<username>:<password>@localhost:5432/<database_name>
DATABASE_URL=postgresql://postgres:sakshi@localhost:5432/greenledger

# JWT Security Key
SECRET_KEY=greenledger_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MQTT Sensor Broker Settings
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=greenledger/sensors/#

# Application Mode
ENVIRONMENT=development
DEBUG=True
